# Environment Variables Example
# Copy this file and fill in your values
# DO NOT commit actual credentials to the repository

# ============================================
# CLOUDINARY (Required)
# ============================================
# Create a free account at https://cloudinary.com

CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=symmetry_news_unsigned

# ============================================
# ENVIRONMENT (Optional)
# ============================================
# Values: development, production

ENV=development

# ============================================
# FIREBASE (Optional - handled by firebase_options.dart)
# ============================================
# These are optional overrides. Firebase config is primarily
# handled by running `flutterfire configure` which generates
# lib/firebase_options.dart

# FIREBASE_API_KEY=your_api_key
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# FIREBASE_APP_ID=your_app_id
